# Copy this file to ".env" and fill in the values. ".env" is in .gitignore: never commit it.
# In production (Streamlit Community Cloud) these same keys are defined as app "secrets",
# not in an .env file.

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# MedGemma endpoint on RunPod Serverless (added in Step 4)
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=

# Read-only Hugging Face token, so the RunPod worker can download MedGemma's
# gated weights. Also pasted as the HF_TOKEN env var when creating the
# RunPod endpoint itself.
# HF_TOKEN=
